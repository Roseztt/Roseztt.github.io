---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sea from '../../components/Sea.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const base = import.meta.env.BASE_URL;
---

<Base title={`${post.data.title} — ${profile.name}`} description={post.data.summary}>
  <article class="post wrap">
    <a class="back arrow-link" href={`${base}writing/`}><span aria-hidden="true">←</span> All writing</a>
    <p class="label">{date}</p>
    <h1>{post.data.title}</h1>
    <p class="summary">{post.data.summary}</p>
    <div class="prose">
      <Content />
    </div>
  </article>

  <Sea />
</Base>

<style>
  .post { max-width: 760px; padding-top: 130px; padding-bottom: 40px; }
  .back { font-size: 15px; margin-bottom: 40px; }
  h1 { font-size: clamp(40px, 7vw, 68px); margin-top: 12px; }
  .summary { margin-top: 18px; font-size: 20px; color: var(--ink-soft); }
  .prose { margin-top: 44px; font-size: 18px; line-height: 1.8; }
  .prose :global(p) { margin: 0 0 1.2em; }
  .prose :global(h2) { font-size: 30px; margin: 1.8em 0 0.6em; }
  .prose :global(h3) { font-size: 23px; margin: 1.6em 0 0.5em; }
  .prose :global(a) { color: var(--accent); text-underline-offset: 4px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; margin: 0 0 1.2em; }
  .prose :global(blockquote) { margin: 1.5em 0; padding-left: 18px; border-left: 3px solid var(--w-teal); color: var(--ink-soft); }
  .prose :global(code) { font-size: 0.9em; background: var(--rule); padding: 2px 6px; border-radius: 5px; }
  .prose :global(pre) { overflow-x: auto; padding: 16px; border-radius: 10px; background: var(--rule); }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(img) { max-width: 100%; border-radius: 10px; }
</style>
